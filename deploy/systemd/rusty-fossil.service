[Unit]
Description=Rusty-Fossil controller
After=network-online.target rusty-fossil-supervisord.service
Wants=network-online.target rusty-fossil-supervisord.service

[Service]
Type=simple
User=pi
Group=pi
# `pi` remains in the host docker group. Mask the Engine socket in this unit's
# mount namespace; also deny process-memory inspection of the supervisor.
EnvironmentFile=/etc/rusty-fossil/rusty-fossil.env
StateDirectory=rusty-fossil
StateDirectoryMode=0750
WorkingDirectory=/var/lib/rusty-fossil
ExecStart=/usr/local/bin/rusty-fossil
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=~ptrace process_vm_readv process_vm_writev pidfd_getfd
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/run/docker.sock

[Install]
WantedBy=multi-user.target
