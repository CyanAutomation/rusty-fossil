# The digest is the reviewed multi-architecture Node 26 Bookworm slim image.
FROM node:26-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68 AS dependencies

ENV npm_config_audit=false \
    npm_config_fund=false \
    npm_config_update_notifier=false

WORKDIR /opt/pi
COPY worker/pi/package.json worker/pi/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && ./node_modules/.bin/pi --version

FROM node:26-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68 AS worker

ENV HOME=/tmp/pi-home \
    PI_CODING_AGENT_DIR=/tmp/pi-agent \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0 \
    TMPDIR=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/worker /workspace /tmp/pi-home /tmp/pi-agent \
    && chown -R 65532:65532 /workspace /tmp/pi-home /tmp/pi-agent

WORKDIR /workspace
COPY --from=dependencies --chown=65532:65532 /opt/pi/node_modules /opt/pi/node_modules
COPY --chown=65532:65532 worker/pi/worker.mjs /opt/worker/worker.mjs

USER 65532:65532
ENTRYPOINT ["node", "/opt/worker/worker.mjs"]
