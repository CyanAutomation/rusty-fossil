# Runtime mode. HTTP Soyuz origins are allowed only in development and only on loopback.
RUSTY_FOSSIL_ENV=development

# Local diagnostics. Compose overrides the bind address inside its container.
RUSTY_FOSSIL_BIND=127.0.0.1:8080
RUSTY_FOSSIL_STATE_DIR=./state
RUSTY_FOSSIL_LOG_LEVEL=info
RUSTY_FOSSIL_POLL_INTERVAL_SECONDS=5
RUSTY_FOSSIL_REQUEST_TIMEOUT_SECONDS=10

# Soyuz is mandatory for execution. Empty values keep diagnostics running but never ready.
SOYUZ_API_ORIGIN=
SOYUZ_WORKER_ID=
SOYUZ_WORKER_API_TOKEN_FILE=

# Keep the Queue credential separate from the Soyuz worker credential.
# Phase 1 never connects to or consumes a Queue.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_ID=
CLOUDFLARE_QUEUE_TOKEN_FILE=
