# Verified on Agentlab on 2026-11-26; recheck these values before deployment.
# The numeric identity makes the container processes run with the host pi UID/GID.
RUSTY_FOSSIL_UID=1000
RUSTY_FOSSIL_GID=1000
DOCKER_GID=985

RUSTY_FOSSIL_IMAGE=rusty-fossil:agentlab
RUSTY_FOSSIL_HOST_STATE_DIR=/var/lib/rusty-fossil
RUSTY_FOSSIL_RUNTIME_DIR=/var/lib/rusty-fossil/run
RUSTY_FOSSIL_HOST_PORT=8080
RUSTY_FOSSIL_LOG_LEVEL=info
DOCKER_SOCKET_PATH=/run/docker.sock

# Supervisor configuration is synthetic-only. The referenced worker image must
# be the trusted GHCR repository pinned to its published sha256 digest.
FOSSIL_SUPERVISOR_IMAGE=ghcr.io/cyanautomation/rusty-fossil-synthetic-worker@sha256:REPLACE_WITH_64_HEX_DIGEST
FOSSIL_SUPERVISOR_SCENARIO=success
SOYUZ_API_ORIGIN=https://soyuz.example.invalid
SOYUZ_WORKER_ID=rusty-fossil-agentlab
SOYUZ_WORKER_API_TOKEN_HOST_FILE=./secrets/soyuz_worker_api_token
FOSSIL_SUPERVISOR_IPC_TOKEN_HOST_FILE=./secrets/fossil_supervisor_ipc_token

# Optional Senku origin for the explicit docker-compose.senku.yml overlay only.
SENKU_API_ORIGIN=https://senku.scheimann.workers.dev
SENKU_API_TOKEN_HOST_FILE=./secrets/senku_api_token
