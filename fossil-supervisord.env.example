# Supervisor and controller must use the same private SQLite database.
FOSSIL_SUPERVISOR_SOCKET=/run/rusty-fossil-supervisor/supervisor.sock
FOSSIL_SUPERVISOR_STATE_DB=/var/lib/rusty-fossil/fossil.sqlite3

# Production must use the fixed trusted repository with an immutable digest.
# Replace the placeholder with the published linux/amd64 or linux/arm64 digest.
FOSSIL_SUPERVISOR_IMAGE=ghcr.io/cyanautomation/rusty-fossil-synthetic-worker@sha256:REPLACE_WITH_64_HEX_DIGEST

# Use a dedicated Soyuz worker identity and private token files (mode 0400).
SOYUZ_WORKER_ID=rusty-fossil-nonprod
SOYUZ_API_ORIGIN=https://soyuz.example.invalid
SOYUZ_WORKER_API_TOKEN_FILE=/etc/rusty-fossil/soyuz_worker_api_token
FOSSIL_SUPERVISOR_IPC_TOKEN_FILE=/etc/rusty-fossil/supervisor_ipc_token

# Select only a fixed test scenario; this does not enable Queue intake.
FOSSIL_SUPERVISOR_SCENARIO=success
FOSSIL_SUPERVISOR_DOCKER_SOCKET=/var/run/docker.sock

# Bounded defaults. Values outside supported ranges fail before Docker starts.
FOSSIL_SUPERVISOR_CPU_MILLICORES=500
FOSSIL_SUPERVISOR_MEMORY_MIB=256
FOSSIL_SUPERVISOR_PID_LIMIT=32
FOSSIL_SUPERVISOR_TEMPORARY_STORAGE_MIB=16
FOSSIL_SUPERVISOR_MAX_RUNTIME_SECONDS=900
FOSSIL_SUPERVISOR_CANCELLATION_GRACE_SECONDS=5
FOSSIL_SUPERVISOR_MONITOR_CADENCE_MILLIS=500
FOSSIL_SUPERVISOR_SOYUZ_OUTAGE_GRACE_SECONDS=30
FOSSIL_SUPERVISOR_MAX_OUTPUT_BYTES=65536
